{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://cowlark.com/mir.schema.json",
    "title": "mir",
    "description": "Machine-readable description of an X Intrinsics (Xt) widget set, primarily Motif.",
    "type": "object",
    "properties": {
        "prefix": {
            "description": "Toolkit prefix stripped from widget class names to derive widget keys.",
            "type": "string"
        },
        "widgets": {
            "description": "Widgets keyed by widget class symbol (e.g. xmPushButtonWidgetClass).",
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "name": {
                        "description": "Human-readable name of the widget, derived by stripping the toolkit prefix and the trailing WidgetClass suffix.",
                        "type": "string"
                    },
                    "include": {
                        "description": "Path to the header file that declares the widget class.",
                        "type": "string"
                    },
                    "superclass": {
                        "description": "The WidgetClass symbol pointing to the class record referenced by core.superclass (e.g. xmPrimitiveWidgetClass).",
                        "type": "string"
                    },
                    "methods": {
                        "description": "Dictionary of methods associated with the widget, filtered to only those whose name starts with prefix + widget name (case-insensitive), keyed by method symbol (full function name, e.g. XmCascadeButtonHighlight).",
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "description": "Human-readable method name with prefix and widget name stripped (e.g. Highlight for XmCascadeButtonHighlight).",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "name"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "resources": {
                        "description": "Dictionary of resources declared in core.resources, keyed by resource name. Entries may be empty placeholders during extraction.",
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "description": "Resource type name (XtResource.resource_type, e.g. XmRPixel).",
                                    "type": "string"
                                },
                                "class": {
                                    "description": "Resource class name (XtResource.resource_class, e.g. XmCBackground).",
                                    "type": "string"
                                }
                            },
                            "anyOf": [
                                {"maxProperties": 0},
                                {"required": ["type", "class"]}
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "anyOf": [
                    {"maxProperties": 0},
                    {
                        "required": ["superclass"],
                        "maxProperties": 1
                    },
                    {
                        "required": ["resources"],
                        "propertyNames": {"enum": ["superclass", "resources"]}
                    },
                    {
                        "required": [
                            "name",
                            "include",
                            "superclass",
                            "methods",
                            "resources"
                        ]
                    }
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "prefix",
        "widgets"
    ],
    "additionalProperties": false
}
